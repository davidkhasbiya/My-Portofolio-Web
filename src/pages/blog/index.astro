---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Ambil semua data tulisan dari src/content/blog
const posts = await getCollection('blog');

// Urutkan postingan berdasarkan tanggal rilis terbaru
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog — David">
	<div class="space-y-12 py-4">
		
		<header>
			<h1 class="text-3xl font-bold tracking-tight mb-3 text-zinc-900 dark:text-zinc-50">Catatan & Pemikiran</h1>
			<p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed max-w-2xl">
				Tempat saya mendokumentasikan proses belajar, kustomisasi sistem operasi, optimasi perangkat lunak, dan eksperimen teknologi lainnya.
			</p>
		</header>

		<section class="divide-y divide-zinc-100 dark:divide-zinc-900 border-t border-b border-zinc-100 dark:border-zinc-900">
			{sortedPosts.map((post) => (
                <a href={`/blog/${post.id}`} class="flex flex-col sm:flex-row sm:items-center justify-between py-4 group hover:px-2 transition-all duration-200">
                    <span class="text-sm font-medium text-zinc-800 dark:text-zinc-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                        {post.data.title}
                    </span>
                    <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500 shrink-0 mt-1 sm:mt-0">
                        {post.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long' })}
                    </span>
                </a>
            ))}
		</section>

	</div>
</Layout>