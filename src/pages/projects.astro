<script>
	document.addEventListener("astro:page-load", () => {
		// --- FITUR 1: MODAL PREVIEW PDF ---
		const modal = document.getElementById("certModal");
		const modalPdf = document.getElementById("modalPdf") as HTMLIFrameElement;
		const modalTitle = document.getElementById("modalTitle");
		const closeBtn = document.getElementById("closeModal");
		const openButtons = document.querySelectorAll("[data-open-cert]");

		if (modal && modalPdf && closeBtn) {
			openButtons.forEach(btn => {
				btn.addEventListener("click", (e) => {
					const target = e.currentTarget as HTMLElement;
					const src = target.getAttribute("data-src");
					const title = target.getAttribute("data-title");
					
					if (src) {
						modalPdf.src = src;
						if (modalTitle && title) modalTitle.textContent = title;
						modal.classList.remove("hidden");
						modal.classList.add("flex");
						document.body.style.overflow = "hidden";
					}
				});
			});

			const closeModalFunc = () => {
				modal.classList.add("hidden");
				modal.classList.remove("flex");
				modalPdf.src = "";
				document.body.style.overflow = "";
			};

			closeBtn.addEventListener("click", closeModalFunc);
			modal.addEventListener("click", (e) => { if (e.target === modal) closeModalFunc(); });
			document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !modal.classList.contains("hidden")) closeModalFunc(); });
		}

		// --- FITUR 2: INDEPENDENT SEARCH & SORT SYSTEM ---
		const sections = document.querySelectorAll(".table-section");

		sections.forEach(section => {
			const searchInput = section.querySelector(".search-input") as HTMLInputElement;
			const tableBody = section.querySelector("tbody");
			const headers = section.querySelectorAll(".sort-header");
			
			if (!tableBody) return;
			let rows = Array.from(tableBody.querySelectorAll("tr"));

			// Logika Live Search
			if (searchInput) {
				searchInput.addEventListener("input", () => {
					const query = searchInput.value.toLowerCase().trim();
					rows.forEach(row => {
						const text = row.textContent?.toLowerCase() || "";
						if (text.includes(query)) {
							row.style.display = "";
						} else {
							row.style.display = "none";
						}
					});
				});
			}

			// Logika Table Sorting (Tahun & Nama)
			headers.forEach(header => {
				header.addEventListener("click", () => {
					const type = header.getAttribute("data-sort");
					const index = Array.from(header.parentElement?.children || []).indexOf(header);
					const currentOrder = header.getAttribute("data-order") || "desc"; // Default sorting bawaan data kamu desc
					const nextOrder = currentOrder === "desc" ? "asc" : "desc";
					
					// Reset icon di header lain dalam section yang sama
					headers.forEach(h => {
						h.removeAttribute("data-order");
						const icon = h.querySelector(".sort-icon");
						if (icon) icon.textContent = "";
					});

					// Set order baru
					header.setAttribute("data-order", nextOrder);
					const icon = header.querySelector(".sort-icon");
					if (icon) icon.textContent = nextOrder === "asc" ? "▲" : "▼";

					// Proses Sorting Array DOM Rows
					rows.sort((rowA, rowB) => {
						const cellA = rowA.children[index] as HTMLElement;
						const cellB = rowB.children[index] as HTMLElement;
						
						const valA = cellA.getAttribute("data-val") || cellA.textContent?.trim() || "";
						const valB = cellB.getAttribute("data-val") || cellB.textContent?.trim() || "";

						if (type === "number") {
							return nextOrder === "asc" ? Number(valA) - Number(valB) : Number(valB) - Number(valA);
						} else {
							return nextOrder === "asc" ? valA.localeCompare(valB) : valB.localeCompare(valA);
						}
					});

					// Render ulang susunan baris ke DOM
					rows.forEach(row => tableBody.appendChild(row));
				});
			});
		});
	});
</script>