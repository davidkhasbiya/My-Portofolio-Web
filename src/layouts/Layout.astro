---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Portofolio Minimalis" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
		
		<ClientRouter />

		<script is:inline>
			const applyTheme = () => {
				const theme = (() => {
					if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
						return localStorage.getItem('theme');
					}
					return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				})();
				
				if (theme === 'dark') {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			};

			applyTheme();
			document.addEventListener('astro:after-swap', applyTheme);
		</script>
	</head>
	<body class="bg-zinc-50 text-zinc-900 dark:bg-zinc-950 dark:text-zinc-100 font-sans antialiased transition-colors duration-300 selection:bg-indigo-500/30">
		
		<div class="max-w-5xl mx-auto px-6 py-12 min-h-screen flex flex-col justify-between">
			
			<!-- BAGIAN ATAS (NAVBAR & KONTEN) -->
			<div>
				<!-- NAVBAR GLOBAL -->
				<nav class="flex justify-between items-center w-full mb-16">
					<a href="/" class="font-bold tracking-tight hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors text-lg">
						david.
					</a>
					<div class="flex items-center gap-6 text-xs md:text-sm font-medium text-zinc-500 dark:text-zinc-400">
						<a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Home</a>
						<a href="/about" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">About</a>
						<a href="/projects" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Projects</a>
						<a href="/blog" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Blog</a>
						
						<button id="themeToggle" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors p-1 focus:outline-none border-l border-zinc-200 dark:border-zinc-800 pl-4" aria-label="Toggle Theme">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 block dark:hidden">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m0 13.5V21M4.318 4.318l1.591 1.591M18.091 18.091l1.591 1.591M6 12H3.75m16.5 0H18M4.318 19.682l1.591-1.591M18.091 5.909l1.591 1.591M12 7.5a4.5 4.5 0 100 9 4.5 4.5 0 000-9z" />
							</svg>
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 hidden dark:block">
								<path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
							</svg>
						</button>
					</div>
				</nav>

				<!-- KONTEN UTAMA -->
				<main>
					<slot /> 
				</main>
			</div>

			<!-- FOOTER -->
			<footer class="border-t border-zinc-200 dark:border-zinc-900 pt-8 w-full flex flex-col md:flex-row justify-between items-center gap-4 text-xs">
				<p class="text-zinc-500 dark:text-zinc-400 text-center md:text-left">
					Tertarik ngulik bareng? <a href="mailto:emailmu@domain.com" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">Let's chat.</a>
				</p>
				<div class="flex gap-4 font-medium text-zinc-500 dark:text-zinc-400">
					<a href="https://mail.google.com/mail/?view=cm&fs=1&to=davidk3476@gmail.com" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Email</a>
					<a href="https://wa.me/6281249495453" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">WhatsApp</a>
					<a href="https://github.com/davidkhasbiya" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">GitHub</a>
					<a href="https://www.linkedin.com/in/ahmad-david-khasbiya-200101374/" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">LinkedIn</a>
					<a href="https://instagram.com/david.khasbiya" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Instagram</a>
				</div>
			</footer>
		</div>

		<!-- Logika Interaksi Pengubah Tema -->
		<script>
			document.addEventListener("astro:page-load", () => {
				const toggleBtn = document.getElementById("themeToggle");
				
				if (toggleBtn) {
					toggleBtn.addEventListener("click", () => {
						const element = document.documentElement;
						element.classList.toggle("dark");
						
						const isDark = element.classList.contains("dark");
						localStorage.setItem("theme", isDark ? "dark" : "light");
					});
				}
			});
		</script>

		<!-- ========================================== -->
		<!-- EASTER EGG: MINI CLI TERMINAL SIMULATOR   -->
		<!-- ========================================== -->
		<div id="cli-terminal" class="fixed bottom-0 inset-x-0 h-64 bg-zinc-950 border-t border-zinc-800 font-mono text-xs text-zinc-300 p-4 z-[10000] hidden flex-col shadow-2xl transition-all duration-300">
			<!-- Terminal Header -->
			<div class="flex justify-between items-center border-b border-zinc-800 pb-2 mb-2 text-zinc-500 select-none">
				<div class="flex items-center gap-2">
					<span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
					<span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
					<span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
					<span class="ml-2 text-[10px] font-mono tracking-wider text-zinc-400">david@ub-terminal:~</span>
				</div>
				<span class="text-[10px]">Tekan ` (backtick) untuk keluar</span>
			</div>

			<!-- Terminal Output Logs -->
			<div id="cli-output" class="flex-1 overflow-y-auto space-y-1.5 pr-2 scrolling-touch scrollbar-none">
				<p class="text-indigo-400">Selamat datang di Terminal Rahasia David. Ketik <span class="text-zinc-100 underline">help</span> untuk melihat daftar perintah.</p>
			</div>

			<!-- Terminal Input Line -->
			<div class="flex items-center gap-2 pt-2 border-t border-zinc-900 mt-2">
				<span class="text-green-400 shrink-0">david@ub-laptop:~$</span>
				<input type="text" id="cli-input" class="flex-1 bg-transparent border-none outline-none focus:ring-0 p-0 text-zinc-100 font-mono text-xs" autofocus autocomplete="off" spellcheck="false" />
			</div>
		</div>

		<script>
			document.addEventListener("astro:page-load", () => {
				const terminal = document.getElementById("cli-terminal");
				const input = document.getElementById("cli-input") as HTMLInputElement;
				const output = document.getElementById("cli-output");

				if (!terminal || !input || !output) return;

				// Daftar perintah yang didukung
				const commands: Record<string, string | (() => string)> = {
					help: "Perintah yang tersedia: <br>• <span class='text-indigo-400'>about</span> - Info singkat tentang David<br>• <span class='text-indigo-400'>neofetch</span> - Tampilkan spesifikasi sistem rahasia<br>• <span class='text-indigo-400'>skills</span> - Daftar alat tempur / tech stack<br>• <span class='text-indigo-400'>socials</span> - Tautan media sosial aktif<br>• <span class='text-indigo-400'>theme</span> - Ganti tema visual website<br>• <span class='text-indigo-400'>clear</span> - Bersihkan layar terminal<br>• <span class='text-indigo-400'>exit</span> - Tutup terminal",
					
					about: "Ahmad David Khasbiya: Mahasiswa Ilmu Komputer Universitas Brawijaya. Seorang Software Development Enthusiast yang benci bloatware dan suka ngulik kustomisasi kernel/OS.",
					
					neofetch: () => `
				<span class="text-indigo-400 font-bold">david@ub-laptop</span><br>
				----------------<br>
				<span class="text-indigo-400">OS</span>: Windows 11 Pro / Linux Mint Core<br>
				<span class="text-indigo-400">Host</span>: Asus Vivobook 14 Pro OLED<br>
				<span class="text-indigo-400">Kernel</span>: 5.15.0-custom-david-ub<br>
				<span class="text-indigo-400">Shell</span>: zsh 5.9 (Hyprland styled)<br>
				<span class="text-indigo-400">CPU</span>: AMD Ryzen 7 5800H @ 4.400GHz<br>
				<span class="text-indigo-400">GPU</span>: NVIDIA GeForce RTX 3050 Mobile<br>
				<span class="text-indigo-400">Memory</span>: 8GB RAM / 512GB NVMe SSD<br>
				<span class="text-indigo-400">Uptime</span>: Tergantung asupan kopi 
					`.trim(),

					skills: " <span class='text-indigo-400 font-bold'>Alat Tempur:</span><br>• Core: Java (OOP), JavaScript, TypeScript, SQL<br>• Frontend: Astro, React, Tailwind CSS<br>• Sys/DevOps: Docker Container, Git, Linux Environment",

					socials: "<span class='text-indigo-400 font-bold'>Hubungi Saya:</span><br>• GitHub: <a href='https://github.com/davidkhasbiya' target='_blank' class='text-indigo-400 underline hover:text-indigo-300'>github.com/davidkhasbiya</a><br>• LinkedIn: <a href='#' class='text-indigo-400 underline hover:text-indigo-300'>Ahmad David Khasbiya</a>",

					theme: () => {
						// Logika mendeteksi dan mengubah tema dark/light bawaan portofoliomu
						const isDark = document.documentElement.classList.contains('dark');
						if (isDark) {
							document.documentElement.classList.remove('dark');
							localStorage.setItem('theme', 'light');
							return " <span class='text-yellow-400'>Sistem dialihkan ke Light Mode. Silau men!</span>";
						} else {
							document.documentElement.classList.add('dark');
							localStorage.setItem('theme', 'dark');
							return " <span class='text-indigo-400'>Sistem dialihkan ke Dark Mode. Nyaman di mata.</span>";
						}
					}
				};

				// Toggle terminal pakai tombol backtick (`)
				document.addEventListener("keydown", (e) => {
					if (e.key === "`") {
						e.preventDefault();
						if (terminal.classList.contains("hidden")) {
							terminal.classList.remove("hidden");
							terminal.classList.add("flex");
							setTimeout(() => input.focus(), 50);
						} else {
							terminal.classList.add("hidden");
							terminal.classList.remove("flex");
						}
					}
				});

				// Proses input command saat Enter ditekan
				input.addEventListener("keydown", (e) => {
					if (e.key === "Enter") {
						const fullCmd = input.value.trim();
						const cmd = fullCmd.toLowerCase();
						input.value = "";

						if (!cmd) return;

						// Cetak ulang perintah yang baru diketik pengguna
						output.innerHTML += `<div><span class="text-green-400">david@ub-laptop:~$</span> ${fullCmd}</div>`;

						// Logika eksekusi perintah
						if (cmd === "clear") {
							output.innerHTML = "";
						} else if (cmd === "exit") {
							terminal.classList.add("hidden");
							terminal.classList.remove("flex");
						} else if (cmd === "sudo rm -rf /") {
							output.innerHTML += `<div class="text-red-500 font-bold animate-pulse"> CRITICAL ERROR: Terdeteksi upaya pembersihan root direktori! Mau ngusilin server UB ya? Akses ditolak! </div>`;
						} else if (cmd === "sudo apt update") {
							output.innerHTML += `<div class="text-green-400">Hit:1 http://repository.brawijaya.ac.id/ubuntu noble InRelease<br>Reading package lists... Done.<br>Status: Portofolio David sudah menggunakan versi paling optimal dan bebas bloatware! </div>`;
						} else if (cmd.startsWith("sudo")) {
							output.innerHTML += `<div class="text-red-400"> David is not in the sudoers file. This incident will be reported.</div>`;
						} else if (commands[cmd]) {
							const res = commands[cmd];
							output.innerHTML += `<div>${typeof res === "function" ? res() : res}</div>`;
						} else {
							output.innerHTML += `<div class="text-zinc-500">Bash: command not found: ${fullCmd}. Ketik 'help' untuk bantuan.</div>`;
						}

						// Auto scroll ke bawah
						output.scrollTop = output.scrollHeight;
					}
				});
			});
		</script>
	</body>
</html>

<style is:global>
	body {
		font-family: 'Inter', sans-serif;
	}
</style>